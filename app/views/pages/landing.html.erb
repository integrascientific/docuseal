<section class="flex items-center justify-center">
  <div class="py-16 mx-auto max-w-xl px-4 text-center">
    <div class="flex flex-col items-center">
      <%= render 'shared/wordmark', tone: :light, class: 'text-2xl md:text-3xl' %>
      <h1 class="text-3xl font-bold mt-8 mb-4">
        <%= Docuseal.product_name %>
      </h1>
    </div>
    <p class="mt-2 mb-10 text-lg text-base-content/80">
      Secure electronic document signing by Integra Scientific.
      If you were asked to sign a document, open the link in the e-mail you received.
    </p>
    <%= link_to t('sign_in'), new_user_session_path, class: 'base-button px-10' %>
    <p class="mt-16 text-sm text-base-content/70">
      Integra Scientific Ltd &middot; Malta &middot;
      <a href="mailto:<%= Docuseal::SUPPORT_EMAIL %>" class="underline"><%= Docuseal::SUPPORT_EMAIL %></a> &middot;
      <a href="<%= Docuseal::PRODUCT_URL %>" class="underline" target="_blank" rel="noopener">www.integrascientific.com</a>
    </p>
  </div>
</section>
